 é que os Handerson precisam fazer de tudo para mantê-lo escondido das autoridades.","year":1987,"genre":["Comédia"],"cat":"Filmes","categoryType":"vod","origem":"Filmes Saimo","id":"VOD_11S6DISD9AA"},"YTN_PT_19U1FK1UXSQ":{"studio":"youtoon/portugues-portugal/cartoonito-portugal-ben-10","idioma":"pt-PT","title":"Cartoonito Portugal · Ben 10","thumb":"https://i.ytimg.com/vi/FgKwy-7t4KA/hqdefault.jpg","url":"https://www.youtube.com/playlist?list=PLSz9ifLtWXQkUN2oamyiLaRhSsO9uGmau","desc":"Playlist de Cartoonito Portugal · 109 vídeos","genre":["Infantil"],"cat":"Desenhos 24H","categoryType":"live","origem":"YouToon · Português (Portugal)","paises":["pt"],"paisVia":"idioma","id":"YTN_PT_19U1FK1UXSQ"}}