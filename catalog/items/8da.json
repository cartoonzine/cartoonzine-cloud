.org/t/p/w500/co47qUCNSa3LIPWwNcqq0PGhnJJ.jpg","bannerThumb":"https://image.tmdb.org/t/p/w1280/lqtzWKCpejXdKb22cav5bB6MqSR.jpg","logo":"https://image.tmdb.org/t/p/w500/2NWQLUh06tiRd3WVTA936RuJqYw.png","url":"https://nixplay.lat/movie/saimo-vods/221097/265297.mp4","idiomas":[{"url":"https://nixplay.lat/movie/saimo-vods/221097/265297.mp4","idioma":"dublado"}],"desc":"Nos últimos 40 anos, o fotógrafo Sebastião Salgado tem viajado através dos continentes, aos passos de uma humanidade sempre em mutação. Ele testemunhou alguns dos principais eventos da nossa história recente; conflitos internacionais, a fome e o êxodo. Ele agora embarca na descoberta de territórios imaculados, da flora e da fauna selvagem e de paisagens grandiosas como parte de um enorme projeto fotográfico. Uma homenagem à beleza do planeta.","year":2014,"genre":["Documentário"],"cat":"Filmes","categoryType":"vod","origem":"Filmes Saimo","id":"VOD_1VFQQVUMSYE"},"VOD_1DAD5L4BADK":{"bannerlogo":"https://image.tmdb.org/t/p/w500/bnb5Gv17btLgRnwBlzvlWcntwX4.png","age":"12","popularity":0,"tmdbId":681478,"tmdbTipo":"movie","title":"Paz e Chocolate","thumb":"https://image.tmdb.org/t/p/w500/7SXPnOYZscdtyCwH8h2lInnSpGs.jpg","bannerThumb":"https://image.tmdb.org/t/p/w1280/ub4jt1vFlcqOPUWMdKW56nM5yPU.jpg","logo":"https://image.tmdb.org/t/p/w500/bnb5Gv17btLgRnwBlzvlWcntwX4.png","url":"http://acaidopt.org:80/movie/3llohwk4g9/kwf099q30o/2767139.mp4","mirrors":["http://dbonline.tech-cdn.top:80/movie/ke-vin-0928392083/PZjF6XATTZ/18608.mp4","https://nixplay.lat/movie/saimo-vods/221097/681478.mp4","http://dbonline.tech-cdn.top:80/movie/ke-vin-0928392083/PZjF6XATTZ/85959.mp4"],"idiomas":[{"url":"http://acaidopt.org:80/movie/3llohwk4g9/kwf099q30o/2767139.mp4","idioma":"dublado"},{"url":"http://dbonline.tech-cdn.top:80/movie/ke-vin-0928392083/PZjF6XATTZ/18608.mp4","idioma":"dublado"},{"url":"https://nixplay.lat/movie/saimo-vods/221097/681478.mp4","idioma":"dublado"},{"url":"http://dbonline.tech-cdn.top:80/movie/ke-vin-092839