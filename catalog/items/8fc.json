 nome com que passam a chamá-lo) começa a se sentir responsável pela introdução de novos elementos naquele universo estagnado. Entre os moradores daquele estranho mundo, Paulo - jovem lavrador, nascido e criado ali - foi o único que se mostrou sensível às estranhas idéias do novo capataz, seu companheiro de quarto. José Roberto começou a se ligar mais profundamente a Paulo, dando-lhe lições diárias, ensinando-o a ler e escrever e preparando-o para uma nova vida.","year":2022,"genre":["Drama"],"cat":"Filmes","categoryType":"vod","origem":"Filmes Saimo","audios":["dublado","legendado"],"id":"VOD_2C7DNVXLMSD"},"VOD_1P6R92JCJH1":{"bannerlogo":"https://image.tmdb.org/t/p/w500/v2SkEmJ6yjzdvV2con5OgYf0SNA.png","popularity":0,"tmdbId":179810,"tmdbTipo":"movie","title":"Quem Se Importa?","thumb":"https://image.tmdb.org/t/p/w500/bUPSokpc4EgQdVYR76cVK6al2Cd.jpg","bannerThumb":"https://image.tmdb.org/t/p/w1280/271oG4Uh4bEkOMWYz072BtIl0ZJ.jpg","logo":"https://image.tmdb.org/t/p/w500/v2SkEmJ6yjzdvV2con5OgYf0SNA.png","url":"http://acaidopt.org:80/movie/3llohwk4g9/kwf099q30o/2759788.mp4","idiomas":[{"url":"http://acaidopt.org:80/movie/3llohwk4g9/kwf099q30o/2759788.mp4","idioma":"dublado"}],"desc":"Documentário sobre empreendedores sociais ao redor do mundo. Pessoas que estão fazendo mudanças, trazendo soluções, gerando enorme impacto social ...","year":2014,"genre":["Documentário"],"cat":"Filmes","categoryType":"vod","origem":"Filmes Saimo","audios":["dublado"],"id":"VOD_1P6R92JCJH1"},"VOD_T68FMHLPNX":{"popularity":0,"title":"Suburbia","thumb":"https://image.tmdb.org/t/p/w500/vydIE7nizxO04ER9EcDdbdaHh8c.jpg","bannerThumb":"https://image.tmdb.org/t/p/w500/vydIE7nizxO04ER9EcDdbdaHh8c.jpg","url":"https://nixplay.lat/movie/saimo-vods/221097/28054.mp4","idiomas":[{"url":"https://nixplay.lat/movie/saimo-vods/221097/28054.mp4","idioma":"dublado"}],"genre":["Filme"],"cat":"Filmes","categoryType":"vod","origem":"Filmes Saimo","audios":["dublado"],"id":"VOD_T68FMHLPNX"}}