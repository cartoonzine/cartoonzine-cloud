{
  "_comentarioFontesDoStudio": "Sistemas novos criados no painel do Cartoonzine Studio (Jogos Web → + Novo sistema) entram sozinhos no catálogo por aqui: o build lê a lista que o Studio publica e acrescenta o que ainda não está em fontes.",
  "fontesDoStudio": [
    {
      "nome": "Cartoonzine Studio · Jogos (retrô e web)",
      "url": "https://raw.githubusercontent.com/cartoonzine/cartoonzine-studio/main/dist/fontes-cloud.json",
      "colecoes": ["jogos", "jogos-web"]
    }
  ],
  "_comentario": "Manifesto único de fontes. Lido pelo build (tools/build-catalog.mjs) e pelo cloud-engine.js no modo legado. Fontes sem URL ou com SEU_USER são ignoradas. destino: videos|games|iptv|radio|streams|audio|filmes|series (em qual lista do app os itens entram). agruparSeries:false mantém episódios soltos (listas M3U do TVzine).",

    "deduplicacao": {
    "_como_usar": "Troque o valor de 'modo' abaixo e salve. O robô gera o catálogo de novo sozinho. Relatórios em catalog/analise/",
    "_modo_ativo": "ativo → No app: as cópias viram um card, com o link da cópia como reserva. No relatório: o que foi retirado e para qual card foi.",
    "_modo_analisar": "analisar → No app: todos os filmes aparecem, nada é juntado. No relatório: o que seria retirado se estivesse ativo.",
    "_modo_desligado": "desligado → No app: sem filtro nenhum, como o motor antigo. No relatório: vazio.",
    "_anoNoTitulo": "true = trata 'Filme (2017)' como 'Filme' do ano 2017 para achar cópias. false = compara o nome como veio.",
    "_travaCapa": "true = nunca junta dois filmes com capas diferentes (evita juntar filmes distintos). false = junta só por título + ano.",

    "modo": "analisar",
    "anoNoTitulo": true,
    "travaCapa": true
  },
  
  "validacao": {
    "_como_usar": "Teste dos links a cada 6h. Relatórios em catalog/analise/validacao*.json. Detalhes em tools/validador/LEIAME.md",
    "_modo_relatorio": "relatorio → No app: nada muda. No relatório: quais links funcionam, quais falharam e por quê. Comece por este.",
    "_modo_otimizar": "otimizar → No app: a fonte que funciona vai para a frente e as outras viram reserva (nenhuma é apagada).",
    "_modo_desligado": "desligado → não testa nada.",
    "_apenasFontes": "Só as fontes desta lista são testadas. As outras ficam exatamente como vieram.",
    "_semFonte": "marcar = item com TODAS as fontes falhando por 'falhasParaIndisponivel' ciclos seguidos recebe indisponivel:true | remover = sai do catálogo (nunca mais de 20% de uma vez).",

    "modo": "relatorio",
    "apenasFontes": [
      "Filmes Saimo",
      "Séries Saimo",
      "Adultos Saimo",
      "TVzine - Canais (Saimo)"
    ],
    "manterReservas": true,
    "semFonte": "marcar",
    "falhasParaIndisponivel": 3,
    "concorrencia": 16,
    "porHost": 2,
    "timeoutMs": 8000,
    "ttlOkHoras": 24,
    "orcamentoMin": 20,
    "prioridadeServidores": {}
  },

